#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../config/application"
require "importmap/npm"
require "json"
require "open3"
require_relative "../lib/security_updates/advisory"
require_relative "../lib/security_updates/audit"
require_relative "../lib/security_updates/version_changes"
require_relative "../lib/security_updates/report"

def gem_advisories
  report, = Open3.capture2("bin/bundler-audit", "check", "--format", "json")
  SecurityUpdates::Audit.gems(JSON.parse(report))
end

def pin_advisories
  SecurityUpdates::Audit.pins(Importmap::Npm.new.vulnerable_packages)
end

found_gems = gem_advisories
gems = found_gems.reject { |advisory| advisory.id == SecurityUpdates::Audit::INSECURE_SOURCE_ID }
pins = pin_advisories
found = found_gems + pins
lockfile_before = File.read("Gemfile.lock")
importmap_before = File.read("config/importmap.rb")

system("bundle", "update", "--conservative", *gems.map(&:package).uniq, exception: true) if gems.any?
system("bin/importmap", "pin", *pins.map(&:package).uniq, exception: true) if pins.any?

changes = SecurityUpdates::VersionChanges.gems(lockfile_before, File.read("Gemfile.lock")) +
  SecurityUpdates::VersionChanges.pins(importmap_before, File.read("config/importmap.rb"))
report = SecurityUpdates::Report.new(found:, remaining: gem_advisories + pin_advisories, changes:)
File.write(ARGV.fetch(0), report.to_markdown)

exit 2 if report.unresolved?
